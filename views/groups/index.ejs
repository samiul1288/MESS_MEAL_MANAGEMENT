<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
  <div>
    <h1>Mess Groups</h1>
    <p class="text-muted mb-0">Create groups and assign member accounts from member profiles.</p>
  </div>
  <a class="btn btn-primary" href="/groups/create">Add group</a>
</div>

<div class="card mt-3">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Name</th><th>Code</th><th>Description</th><th>Members</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% if (groups.length) { %>
            <% groups.forEach(group => { %>
              <tr>
                <td><%= group.name %></td>
                <td><span class="badge text-bg-light"><%= group.code %></span></td>
                <td><%= group.description || '—' %></td>
                <td><%= group.member_count %></td>
                <td class="d-flex gap-2">
                  <a class="btn btn-sm btn-outline-primary" href="/groups/<%= group.id %>/edit">Edit</a>
                  <form action="/groups/<%= group.id %>/delete" method="POST" data-confirm="Delete this group? Groups with linked data cannot be deleted.">
                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="5" class="text-center">No mess groups yet. Add your first group to get started.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
