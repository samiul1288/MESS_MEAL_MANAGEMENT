<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#f4f7fb">
  <meta name="description" content="Manage mess meals, shared expenses and payments with MessMate.">
  <title><%= title || 'MessMate' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/app.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <style nonce="<%= cspNonce %>">
    .inline-chart-initializer { display: none; }
  </style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <%- include('../partials/navbar') %>
  <% if (flash && flash.success) { %>
    <div class="container pt-3" role="status">
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        <%= flash.success %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
      </div>
    </div>
  <% } %>
  <% if (flash && flash.error) { %>
    <div class="container pt-3" role="alert">
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= flash.error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss message"></button>
      </div>
    </div>
  <% } %>
  <main id="main-content" class="container">
    <%- body %>
  </main>
  <%- include('../partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script nonce="<%= cspNonce %>">
    document.addEventListener('submit', (event) => {
      const message = event.target.dataset.confirm;
      if (message && !window.confirm(message)) event.preventDefault();
    });
  </script>
</body>
</html>
